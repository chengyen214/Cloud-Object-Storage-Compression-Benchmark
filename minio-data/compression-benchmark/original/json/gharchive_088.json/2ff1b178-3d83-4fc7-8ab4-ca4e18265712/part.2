        "title": "build(deps): bump urllib3 from 2.0.7 to 2.2.2",
        "user": {
          "login": "dependabot[bot]",
          "id": 49699333,
          "node_id": "MDM6Qm90NDk2OTkzMzM=",
          "avatar_url": "https://avatars.githubusercontent.com/in/29110?v=4",
