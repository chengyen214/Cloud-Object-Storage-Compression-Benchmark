ons.snappy();\n+\n+\t\tif (Brotli.isAvailable()) {\n+\t\t\tbrotliOptions = StandardCompressionOptions.brotli();\n+\t\t}\n+\n+\t\tif (Zstd.isAvailable()) {\n+\t\t\tzstdOptions = StandardCompressionOptions.zstd();\n+\t\t}\n+\t}",
