        "title": "Constructor member types aren't linted correctly",
        "user": {
          "login": "KeeVeeGames",
          "id": 10993317,
          "node_id": "MDQ6VXNlcjEwOTkzMzE3",
          "avatar_url": "https://avatars.githubusercontent.com/u/10993317?v=4",
          "gravatar_id": "",
          "url": "https://api.github.com/users/KeeVeeGames",
          "html_url": "https://github.com/KeeVeeGames",
          "followers_url": "https://api.github.com/users/KeeVeeGames/followers",
          "following_url": "https://api.github.com/users/KeeVeeGames/following{/other_user}",
          "gists_url": "https://api.github.com/users/KeeVeeGames/gists{/gist_id}",
          "starred_url": "https://api.github.com/users/KeeVeeGames/starred{/owner}{/repo}",
          "subscriptions_url": "https://api.github.com/users/KeeVeeGames/subscriptions",
          "organizations_url": "https://api.github.com/users/KeeVeeGames/orgs",
          "repos_url": "https://api.github.com/users/KeeVeeGames/repos",
          "events_url": "https://api.github.com/users/KeeVeeGames/events{/privacy}",
          "received_events_url": "https://api.github.com/users/KeeVeeGames/received_events",
          "type": "User",
