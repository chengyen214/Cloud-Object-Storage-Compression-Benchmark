      "commits": [
        {
          "sha": "ae34659b26fd96c63cf0c390ddfee72ec6edfa32",
          "author": {
            "email": "a1364259@163.com",
            "name": "残页"
          },
          "message": "No kernel repack if it isn't patched at all\n\nIt turns out that decompressing and recompressing the kernel is enough to break booting on many devices that use MT6763.\r\nFix #5124, fix #6204, fix #6566 \r\n\r\nCo-authored-by: LoveSy <shana@zju.edu.cn>\r\nCo-authored-by: 南宫雪珊 <vvb2060@gmail.com>",
          "distinct": true,
