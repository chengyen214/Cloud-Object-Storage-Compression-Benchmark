          "author": {
            "email": "charlie.lin@amd.com",
            "name": "Charlie Lin"
          },
          "message": "Remove __AMDGCN_WAVEFRONT_SIZE for deprecation (#3714)\n\nNew compiler is deprecating this macro\r\nWorks on MI300X with compiler staging docker",
          "distinct": false,
          "url": "https://api.github.com/repos/ROCm/AMDMIGraphX/commits/ebf82f61f3144fb476d9ab2bd89628db186b8430"
