        {
          "sha": "af104bb121b5838069cc07ae5204cea44cdc3ad4",
          "author": {
            "email": "107195283+TedThemistokleous@users.noreply.github.com",
            "name": "Ted Themistokleous"
          },
          "message": "Parser changes to handle MatMulIntegerToFloat (#3445)\n\nChanges to MatMul parser to handle the Microsoft Contrib operator MatMulintegarToFloat\r\n\r\nSince we have the scale and zero points in our operands we can just perform a multiplied after int8 biases are added and then insert a regular dot on the scaled input values which should give the same output as the input data types.\r\n\r\nAble to leverage the existing set of tests for matmul",
          "distinct": false,
          "url": "https://api.github.com/repos/ROCm/AMDMIGraphX/commits/af104bb121b5838069cc07ae5204cea44cdc3ad4"
        },
