          "author": {
            "email": "paul.fultz@amd.com",
            "name": "Paul Fultz II"
          },
          "message": "Fuse transposes in pointwise and reduce fusions (#3705)\n\nThis uses the shape_transform_descriptor to track how the axes are changed throughout the transformation. This adds method to get the common dimensions and generate operators for different points of the rewrite.",
          "distinct": false,
          "url": "https://api.github.com/repos/ROCm/AMDMIGraphX/commits/a678b48425ff3a8c779e80a8610743f6ce66e595"
