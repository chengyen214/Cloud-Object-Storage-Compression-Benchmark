          },
          "message": "Bump rocm-docs-core from 1.11.0 to 1.12.0 in /docs/sphinx (#3719)",
          "distinct": false,
          "url": "https://api.github.com/repos/ROCm/AMDMIGraphX/commits/be91bd1f781b267e37eabfb4d82eed9098e0efdb"
