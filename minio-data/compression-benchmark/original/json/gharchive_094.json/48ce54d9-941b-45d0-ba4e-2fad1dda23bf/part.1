          {
            "id": 3695430702,
            "node_id": "LA_kwDODkcr587cQ8wu",
            "url": "https://api.github.com/repos/LORD-MicroStrain/microstrain_inertial/labels/New",
            "name": "New",
            "color": "552BE3",
            "default": false,
