            "name": "Alejandro Colomar"
          },
          "message": "lib/, src/: Use asprintf_() instead of asprintf(3)\n\nSigned-off-by: Alejandro Colomar <alx@kernel.org>",
          "distinct": true,
          "url": "https://api.github.com/repos/alejandro-colomar/shadow/commits/216423ac326c056c251547f77ada867bd63a33ea"
        },
