        "title": "Unable to get the scanner to scan after pairing",
        "user": {
          "login": "slepmog",
          "id": 7415007,
          "node_id": "MDQ6VXNlcjc0MTUwMDc=",
          "avatar_url": "https://avatars.githubusercontent.com/u/7415007?v=4",
          "gravatar_id": "",
          "url": "https://api.github.com/users/slepmog",
