          "following_url": "https://api.github.com/users/iurii-ssv/following{/other_user}",
          "gists_url": "https://api.github.com/users/iurii-ssv/gists{/gist_id}",
          "starred_url": "https://api.github.com/users/iurii-ssv/starred{/owner}{/repo}",
          "subscriptions_url": "https://api.github.com/users/iurii-ssv/subscriptions",
          "organizations_url": "https://api.github.com/users/iurii-ssv/orgs",
          "repos_url": "https://api.github.com/users/iurii-ssv/repos",
          "events_url": "https://api.github.com/users/iurii-ssv/events{/privacy}",
          "received_events_url": "https://api.github.com/users/iurii-ssv/received_events",
          "type": "User",
