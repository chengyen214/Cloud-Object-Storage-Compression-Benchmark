        "title": "shares-storage: replace GOB encoding with SSZ, deduplicate validator Index field",
        "user": {
          "login": "iurii-ssv",
          "id": 183610124,
          "node_id": "U_kgDOCvGrDA",
          "avatar_url": "https://avatars.githubusercontent.com/u/183610124?v=4",
