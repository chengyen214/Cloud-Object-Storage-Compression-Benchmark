        "title": "uv add should use ^ instead of >= when adding dependencies to pyproject.toml",
        "user": {
          "login": "kishaningithub",
          "id": 763760,
          "node_id": "MDQ6VXNlcjc2Mzc2MA==",
          "avatar_url": "https://avatars.githubusercontent.com/u/763760?v=4",
          "gravatar_id": "",
          "url": "https://api.github.com/users/kishaningithub",
          "html_url": "https://github.com/kishaningithub",
          "followers_url": "https://api.github.com/users/kishaningithub/followers",
          "following_url": "https://api.github.com/users/kishaningithub/following{/other_user}",
          "gists_url": "https://api.github.com/users/kishaningithub/gists{/gist_id}",
