        "node_id": "PR_kwDOBhEMNM6F5toT",
        "number": 2517,
        "title": "feat: enable local packages and PROJECT_ROOT expansion in requirements files",
        "user": {
          "login": "pamaury",
          "id": 121804,
          "node_id": "MDQ6VXNlcjEyMTgwNA==",
          "avatar_url": "https://avatars.githubusercontent.com/u/121804?v=4",
          "gravatar_id": "",
          "url": "https://api.github.com/users/pamaury",
          "html_url": "https://github.com/pamaury",
          "followers_url": "https://api.github.com/users/pamaury/followers",
          "following_url": "https://api.github.com/users/pamaury/following{/other_user}",
          "gists_url": "https://api.github.com/users/pamaury/gists{/gist_id}",
          "starred_url": "https://api.github.com/users/pamaury/starred{/owner}{/repo}",
          "subscriptions_url": "https://api.github.com/users/pamaury/subscriptions",
          "organizations_url": "https://api.github.com/users/pamaury/orgs",
          "repos_url": "https://api.github.com/users/pamaury/repos",
          "events_url": "https://api.github.com/users/pamaury/events{/privacy}",
          "received_events_url": "https://api.github.com/users/pamaury/received_events",
          "type": "User",
